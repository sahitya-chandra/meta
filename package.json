{
  "name": "meta",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "check-types": "turbo run check-types",
    "db:migrate": "pnpm --filter @repo/db run migrate",
    "db:studio": "pnpm --filter @repo/db run studio",
    "db:generate": "pnpm --filter @repo/db run generate",
    "db:migrate:reset": "pnpm --filter @repo/db run migrate:reset",
    "db:deploy": "pnpm --filter @repo/db run deploy"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2",
    "nodemon": "^3.1.10",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
